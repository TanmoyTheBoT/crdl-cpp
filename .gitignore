# .gitignore for crdl-cpp

# Build directories
build/
cmake-build-*/
out/

# IDE files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Logs
*.log

# Config files with credentials
credentials.json
config.json

# DRM files (user should provide their own)
*.wvd

# Downloads
downloads/

# Temporary files
*.tmp
*.temp
temp/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Package managers
vcpkg_installed/
conan_cache/

# Test outputs
Testing/
